GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# For an Agents and Environments workspace, set the Agent ID. This takes precedence over the project.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=autocare-motors
SERPER_API_KEY=
# Maximum Serper attempts per UTC day. Set either limit to 0 to disable search.
SERPER_DAILY_LIMIT=20
SERPER_THREAD_DAILY_LIMIT=3
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# OAuth credentials for the dealership's calendar account (scope: calendar.events).
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Optional path to the SQLite booking database.
# BOOKINGS_DB_PATH=data/bookings.sqlite

TELEGRAM_BOT_TOKEN=
# API_URL=http://127.0.0.1:8000
# TELEGRAM_SESSIONS_PATH=data/telegram_sessions.sqlite
